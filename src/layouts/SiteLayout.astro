---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteCopy, type Locale, type PageId } from '../content/site';
interface Props { locale: Locale; page: PageId; title: string; description: string; styles: string[]; bodyClass?: string; bodyAttributes?: Record<string, string | boolean | undefined>; headerClass?: string; footerClass?: string; localeSuffix?: string; localeOrder?: Locale[]; shellClass?: string; loadScrollFill?: boolean }
const { locale, page, title, description, styles, bodyClass = `${page}-body`, bodyAttributes = {}, headerClass, footerClass, localeSuffix, localeOrder, shellClass, loadScrollFill = true } = Astro.props;
const headerUtilities = Astro.slots.has('header-utilities');
---
<!doctype html>
<html lang={siteCopy[locale].lang} data-content-id={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070809" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <title>{title}</title>
    {styles.map(href => <link rel="stylesheet" href={href} />)}
    <slot name="head" />
    <script is:inline src="/assets/locale.js" defer></script>
    {loadScrollFill && <script is:inline type="module" src="/assets/scroll-fill.js?v=opening-fluid-2026-11-14-2"></script>}
    <slot name="after-base-scripts" />
  </head>
  <body class={bodyClass} {...bodyAttributes}>
    <a class="skip-link" href="#main-content">{siteCopy[locale].skip}</a>
    {shellClass ? (
      <div class={shellClass}>
        <SiteHeader locale={locale} page={page} headerClass={headerClass} localeSuffix={localeSuffix} localeOrder={localeOrder} headerUtilities={headerUtilities}>
          <slot name="header-utilities" slot="utilities" />
        </SiteHeader>
        <slot />
        <SiteFooter locale={locale} page={page} footerClass={footerClass}><slot name="credit" /></SiteFooter>
      </div>
    ) : (
      <>
        <SiteHeader locale={locale} page={page} headerClass={headerClass} localeSuffix={localeSuffix} localeOrder={localeOrder} headerUtilities={headerUtilities}>
          <slot name="header-utilities" slot="utilities" />
        </SiteHeader>
        <slot />
        <SiteFooter locale={locale} page={page} footerClass={footerClass}><slot name="credit" /></SiteFooter>
      </>
    )}
  </body>
</html>
