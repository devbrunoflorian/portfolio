---
import { aboutArt } from '../../content/about-art';
import type { Locale } from '../../content/site';
interface Props { locale: Locale }
const copy = aboutArt[Astro.props.locale];
---
<section class="journey-panel journey-panel--art about-art-scene" id="art" data-chapter="art" data-journey-panel="art" aria-labelledby="art-title">
  <div class="art-composition" data-art-composition>
    <div class="art-atmosphere" aria-hidden="true">
      <div class="art-smoke art-smoke--violet"></div>
      <div class="art-smoke art-smoke--blue"></div>
    </div>
    <div class="art-paint" aria-hidden="true"></div>
    <div class="art-portrait" data-score-anchor data-media-skeleton>
      <img data-art-image src="/assets/about-legacy/illustrations/art-muse-vitoria-watercolor.png" alt={copy.portraitAlt} width="1470" height="1070" loading="lazy" decoding="async" />
    </div>
    <div class="art-copy">
      <h2 id="art-title">{copy.firstLine}<br />{copy.secondLine} <em>{copy.accent}</em>.</h2>
      <p>{copy.description}</p>
    </div>
  </div>
</section>
