---
import SiteLayout from '../../../layouts/SiteLayout.astro';
const locale = 'pt-br' as const;
---<SiteLayout
  locale={locale}
  page="projects"
  title="Projetos | Bruno Florian"
  description="Galeria espacial com CC Catalog e espaços reservados para projetos futuros."
  styles={[
    '/assets/site.css?v=word-fill-skeleton-review-2026-11-12-3',
    '/assets/projects.css?v=shared-header-64',
    '/assets/site-header.css?v=shared-header-64',
  ]}
  bodyClass="projects-body"
  headerClass="projects-header"
  footerClass="projects-footer"
>
  <script slot="after-base-scripts" is:inline src="/assets/projects.js" defer></script>
<main id="main-content" class="projects-main" tabindex="-1">
      <div class="projects-atmosphere" aria-hidden="true"><span></span><i></i><b></b></div>
      <section class="project-intro" aria-labelledby="projects-title">
        <p class="projects-eyebrow"><span></span> Trabalhos em destaque</p>
        <h1 id="projects-title" class="scroll-fill">Projetos<br /><strong>selecionados.</strong></h1>
        <p class="projects-lede">Um projeto publicado e espaços para trabalhos futuros.</p>
        <div class="project-current" data-project-current aria-live="polite" aria-atomic="true">
          <p class="project-current-index"><span data-project-index>01</span><span aria-hidden="true"> / 05</span><i data-project-status>Disponível</i></p>
          <h2 data-project-title>CC Catalog</h2>
          <p data-project-description>Um catálogo desktop para organizar créditos associados a conteúdos personalizados de The Sims.</p>
          <ul class="project-tags" data-project-tags aria-label="Tecnologias"><li>Electron</li><li>Vite</li><li>React</li><li>sql.js</li><li>Drizzle</li></ul>
          <a class="project-primary-link" data-project-link href="https://github.com/devbrunoflorian/CC-Catalog" target="_blank" rel="noopener noreferrer">Ver repositório <span aria-hidden="true">↗</span></a>
          <p class="project-incoming-note" data-project-incoming hidden>Este espaço está reservado para um projeto futuro.</p>
        </div>
        <div class="project-instructions">
          <span class="project-mouse-icon" aria-hidden="true"><i></i></span>
          <span>Role, arraste ou use as setas</span>
        </div>
      </section>

      <section class="project-gallery" data-project-gallery aria-labelledby="projects-title">
        <div class="project-arc" data-project-arc tabindex="0" role="region" aria-label="Galeria de telas de projetos. Use as setas esquerda e direita para selecionar uma tela.">
          <div class="project-horizon" aria-hidden="true"></div>
          <div class="project-floor" aria-hidden="true"></div>
          <div class="project-reflection" data-project-reflection aria-hidden="true"></div>
          <article class="project-screen is-active" data-project-screen data-project-slot="0" aria-hidden="true">
            <div class="screen-art art-catalog" aria-label="Diagrama conceitual de conteúdos personalizados organizados em um catálogo de créditos">
              <div class="catalog-kicker"><span>CC CATALOG / MAPA</span><span>CONCEITUAL</span></div>
              <div class="catalog-flow" aria-hidden="true">
                <div class="catalog-source"><i></i><i></i><i></i><small>ARQUIVO ZIP</small></div>
                <span class="catalog-link catalog-link-in"></span>
                <div class="catalog-index"><span>CC</span><strong>CATÁLOGO</strong><small>CRIADOR / CONJUNTO / ITEM</small></div>
                <span class="catalog-link catalog-link-out"></span>
                <div class="catalog-credits"><i></i><i></i><i></i><small>CRÉDITOS MARKDOWN</small></div>
              </div>
              <small class="catalog-disclaimer">DIAGRAMA CONCEITUAL · NÃO É CAPTURA DE TELA</small>
            </div>
            <div class="screen-caption"><span>01 / PROJETO</span><h2>CC Catalog</h2><small>Disponível · repositório público</small></div>
          </article>
          <article class="project-screen" data-project-screen data-project-slot="1" aria-hidden="true">
            <div class="screen-art art-wave"><span></span><i></i><b></b><small>RESERVADO / 02</small></div>
            <div class="screen-caption"><span>02 / EM BREVE</span><h2>Em breve</h2><small>Projeto futuro</small></div>
          </article>
          <article class="project-screen" data-project-screen data-project-slot="2" aria-hidden="true">
            <div class="screen-art art-geometry"><span></span><i></i><b></b><small>RESERVADO / 03</small></div>
            <div class="screen-caption"><span>03 / EM BREVE</span><h2>Em breve</h2><small>Projeto futuro</small></div>
          </article>
          <article class="project-screen" data-project-screen data-project-slot="3" aria-hidden="true">
            <div class="screen-art art-orbit-scene"><span></span><i></i><b></b><small>RESERVADO / 04</small></div>
            <div class="screen-caption"><span>04 / EM BREVE</span><h2>Em breve</h2><small>Projeto futuro</small></div>
          </article>
          <article class="project-screen" data-project-screen data-project-slot="4" aria-hidden="true">
            <div class="screen-art art-architecture"><span></span><i></i><b></b><small>RESERVADO / 05</small></div>
            <div class="screen-caption"><span>05 / EM BREVE</span><h2>Em breve</h2><small>Projeto futuro</small></div>
          </article>
        </div>

        <nav class="project-controls" data-project-controls aria-label="Escolher um projeto" hidden>
          <button type="button" data-project-previous aria-label="Projeto anterior">←</button>
          <div class="project-position" role="group" aria-label="Posições dos projetos">
            <button type="button" data-project-select="0" aria-label="01, CC Catalog" aria-pressed="true">01</button>
            <button type="button" data-project-select="1" aria-label="02, Em breve" aria-pressed="false">02</button>
            <button type="button" data-project-select="2" aria-label="03, Em breve" aria-pressed="false">03</button>
            <button type="button" data-project-select="3" aria-label="04, Em breve" aria-pressed="false">04</button>
            <button type="button" data-project-select="4" aria-label="05, Em breve" aria-pressed="false">05</button>
          </div>
          <button type="button" data-project-next aria-label="Próximo projeto">→</button>
        </nav>
      </section>
      <a class="projects-labs-link" href="/pt-br/laboratorios/">Voltar aos Labs <span aria-hidden="true">←</span></a>
    </main>
</SiteLayout>
