---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import AboutJourney from '../../../components/about/AboutJourney.astro';
import AudioPlayerToggle from '../../../components/about/AudioPlayerToggle.tsx';
import AudioMixer from '../../../components/about/AudioMixer.tsx';
import { score } from '../../../../assets/about-legacy/score.js';
import { initialTrackVolumes } from '../../../../assets/about-legacy/track-volumes.js';

const locale = 'pt-br' as const;
const volumeByTrack = initialTrackVolumes(score);
const tracks = score.tracks.map(track => ({
  id: track.id,
  name: track.name,
  initialVolume: volumeByTrack.get(track.id) ?? .5,
}));
---<SiteLayout
  locale={locale}
  page="about"
  title="Sobre | Bruno Florian"
  description="Sobre Bruno Florian."
  styles={[
    '/assets/site.css?v=opening-fluid-2026-11-14-1',
    '/assets/site-header.css?v=about-audio-header-2026-11-11',
    '/assets/about/about.css?v=opening-soft-blend-2026-11-14-1',
    '/assets/about/art-scene.css?v=shared-art-journey-1',
  ]}
  bodyClass=""
  shellClass="site-shell"
  headerClass=""
  footerClass=""
  localeOrder={['en', 'pt-br']}
>
  <AudioPlayerToggle slot="header-utilities" locale={locale} client:load />
  <script slot="head" is:inline>document.documentElement.dataset.aboutIntro = 'ready';</script>
  <script slot="after-base-scripts" is:inline type="module" src="/assets/about/route.js?v=about-art-mask-cleanup-1"></script>
  <script slot="after-base-scripts" is:inline type="module" src="/assets/media-skeleton.js?v=media-skeleton-2026-11-12-3"></script>
<main id="main-content" class="about-rebuild" tabindex="-1" data-about-page data-active-chapter="opening">
      <section class="about-opening" id="opening" data-chapter="opening" aria-labelledby="about-title">
        <div class="opening-scene" data-score-anchor aria-hidden="true">
          <figure class="opening-board-layer" data-opening-table>
            <img class="opening-board-image" src="/assets/about/opening/chess-table-expanded.png" alt="" decoding="async" />
          </figure>
          <figure class="opening-portrait-frame" data-media-skeleton>
            <img class="opening-portrait-image" src="/assets/about/opening/bruno-cutout.png?v=clean-alpha-1" alt="" decoding="async" fetchpriority="high" />
          </figure>
        </div>
        <div class="opening-copy">
          <h1 id="about-title" class="scroll-fill" data-scroll-fill-mode="once" aria-label="Por trás de cada criação, há uma pessoa."><span class="opening-title-wide" data-fill-variant aria-hidden="true"><span class="opening-title-line"><span class="opening-word"><span data-fill-syllable>Por</span></span> <span class="opening-word"><span data-fill-syllable>trás</span></span> <span class="opening-word"><span data-fill-syllable>de</span></span> <span class="opening-word"><span data-fill-syllable>ca</span><span data-fill-syllable>da</span></span> <span class="opening-word"><span data-fill-syllable>cri</span><span data-fill-syllable>a</span><span data-fill-syllable>ção</span><span class="opening-title-period" data-fill-syllable>,</span></span></span><span class="opening-title-line"><span class="opening-word"><span data-fill-syllable>Há</span></span> <span class="opening-word"><span data-fill-syllable>u</span><span data-fill-syllable>ma</span></span> <span class="opening-word"><em><span data-fill-syllable>pe</span><span data-fill-syllable>sso</span><span data-fill-syllable>a</span></em><span class="opening-title-period" data-fill-syllable>.</span></span></span></span><span class="opening-title-narrow" data-fill-variant aria-hidden="true"><span class="opening-title-line"><span class="opening-word"><span data-fill-syllable>Por</span></span> <span class="opening-word"><span data-fill-syllable>trás</span></span> <span class="opening-word"><span data-fill-syllable>de</span></span> <span class="opening-word"><span data-fill-syllable>ca</span><span data-fill-syllable>da</span></span> <span class="opening-word"><span data-fill-syllable>cri</span><span data-fill-syllable>a</span><span data-fill-syllable>ção</span><span class="opening-title-period" data-fill-syllable>,</span></span></span><span class="opening-title-line"><span class="opening-word"><span data-fill-syllable>Há</span></span> <span class="opening-word"><span data-fill-syllable>u</span><span data-fill-syllable>ma</span></span> <span class="opening-word"><em><span data-fill-syllable>pe</span><span data-fill-syllable>sso</span><span data-fill-syllable>a</span></em><span class="opening-title-period" data-fill-syllable>.</span></span></span></span></h1>
          <p class="opening-intro"><span data-opening-sentence>Eu sou Bruno Florian.</span><br class="opening-intro-break"> <span data-opening-sentence>Código, música, arte e uma curiosidade que conecta tudo isso.</span></p>
<p class="sr-only" data-audio-status role="status">Som desligado</p>
        </div>
        <a href="#code" class="opening-scroll" aria-label="Continuar para Code"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </section>

